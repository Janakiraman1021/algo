# AgentPay Backend Configuration Example
PORT=8000
HOST=0.0.0.0
ALGORAND_NETWORK=testnet
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
ALGORAND_APP_ID=0

# Seller / Summary Agent (Receives x402 Micropayments)
ALGORAND_SERVER_ADDRESS=
ALGORAND_SERVER_MNEMONIC=

# Buyer / Payer Agent (Signs and pays 0.01 USDC on Algorand)
ALGORAND_PAYER_ADDRESS=
ALGORAND_PAYER_MNEMONIC=

# x402 Facilitator Settings
X402_FACILITATOR_URL=http://localhost:4020
X402_PRICE_USD=0.01
X402_USDC_ASSET_ID=10458941

# AI Provider: 'gemini', 'groq', 'openai', or 'fallback'
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
